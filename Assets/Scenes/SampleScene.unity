    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "<b>OFFLINE RESPONSE TIME LOG (LANGUAGE: EN)</b>\r\nModel Init (ggml-tiny.bin):
    <b>162 ms</b>\r\nRuns: <b>6</b> | Last: <color=#66FF99><b>271 ms</b></color>
    | Avg: <color=#FFE066><b>114.2 ms</b></color>\r\nMin: <b>64 ms</b> | Max: <b>271
    ms</b> | Avg RTF: <b>0.026x</b>\r\n--------------------------------------------------\r\n#1
    <b>cmd_01_up_right_jump</b> (3.0s) -> <color=#66FF99><b>102 ms</b></color> (0.03x)\n  
    \"Up, right, jump,\" -> <color=#80D8FF>UP (+Y) -> RIGHT (+X) -> JUMP</color>\r\n#2
    <b>cmd_02_left_forward_spin</b> (3.4s) -> <color=#66FF99><b>72 ms</b></color>
    (0.02x)\n   \"Left, forward, spin.\" -> <color=#80D8FF>LEFT (-X) -> FORWARD (+Z)
    -> SPIN ON</color>\r\n#3 <b>cmd_03_bigger_green</b> (2.3s) -> <color=#66FF99><b>64
    ms</b></color> (0.03x)\n   \"Bigger, green.\" -> <color=#80D8FF>SCALE UP -> COLOR
    GREEN</color>\r\n#4 <b>cmd_04_smaller_red_stop</b> (3.4s) -> <color=#66FF99><b>82
    ms</b></color> (0.02x)\n   \"Smaller, red, stop.\" -> <color=#80D8FF>SCALE DOWN
    -> COLOR RED -> STOP</color>\r\n#5 <b>cmd_05_down_back_reset</b> (4.2s) -> <color=#66FF99><b>94
    ms</b></color> (0.02x)\n   \"Down, back, blue, reset.\" -> <color=#80D8FF>DOWN
    (-Y) -> BACK (-Z) -> COLOR BLUE -> RESET</color>\r\n#6 <b>jfk</b> (11.0s) ->
    <color=#66FF99><b>271 ms</b></color> (0.02x)\n   \"And so, my fellow Americans,
    as...\" -> <color=#80D8FF>SAMPLE DEMO (JUMP + SPIN)</color>\r\n--------------------------------------------------\r\nLog
    Saved: <i>OfflineTestLogs/whisper_response_times.csv</i>"
